<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /plumber/

# Allow existing files and directories to be accessed directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean URL rewriting: allow accessing without .php
RewriteCond %{DOCUMENT_ROOT}/plumber/$1.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]
</IfModule>
